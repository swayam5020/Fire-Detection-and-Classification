# Copy to `ml_model/.env` and fill in your local values. `.env` is gitignored
# by the root .gitignore (.env / .env.* patterns) — never commit the real file.
#
#   cp .env.example .env
#
# main.py loads this via python-dotenv at startup.

# Local Postgres connection. This is *your* local instance's credentials —
# not necessarily the same as what a teammate had in their own environment.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sih26_db
DB_USER=postgres
DB_PASSWORD=

# Table the pipeline writes clustered/classified fire events into. Queried
# as `SELECT * FROM {DB_TABLE}` — must contain the 26 ann_features.pkl
# columns plus cluster_id, centroid_lat, centroid_lon.
DB_TABLE=processed_data

# Firebase Realtime Database URL for the ESP32 ground-sensor bridge.
FIREBASE_LIVE_SENSOR_URL=https://farmiq-c8afe-default-rtdb.asia-southeast1.firebasedatabase.app/Greenhouse/Live.json

# Comma-separated list of origins allowed to call this API, or "*" for any
# (fine for local dev; tighten before any public deployment).
CORS_ALLOW_ORIGINS=*
