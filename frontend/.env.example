# Copy this file to `frontend/.env` and adjust. `.env` is gitignored.
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and only reads them at
# dev-server startup — restart `npm run dev` after any change here.

# Origin of the FastAPI backend (`ml_model/main.py`, started with
# `uvicorn main:app --reload` from inside the ml_model/ directory).
# No trailing slash, and no /api/v1 — the route paths are added in
# src/api/clustersApi.ts, and this backend serves /api/thermal-map.
VITE_API_BASE_URL=http://localhost:8000

# "false" switches cluster data from the mock fixtures to the live API.
# Anything else (or unset) keeps mocks, so a fresh checkout runs with no
# backend. Alerts stay on mocks regardless — the backend has no alerts
# endpoint yet; see the comment in src/api/alertsApi.ts.
VITE_USE_MOCK=true
